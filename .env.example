# Hetzner Cloud API token with read+write scope for the project
HCLOUD_TOKEN=your-token-here

# Optional: label key used to select servers and read the target list.
# Default: hetzner-auto-rescale/targets
# LABEL_KEY=hetzner-auto-rescale/targets

# Optional: label key used per server to opt into disk upgrade during rescale.
# Wert "true" / "yes" / "1" am Server -> change_type wird mit upgrade_disk=true ausgefuehrt.
# ACHTUNG: vergroesserte Disk sperrt zukuenftige Downgrades dauerhaft.
# Default: hetzner-auto-rescale/upgrade-disk
# UPGRADE_DISK_LABEL_KEY=hetzner-auto-rescale/upgrade-disk

# Optional: separator used inside the label value to split target server types.
# Hetzner label values must match [a-zA-Z0-9_.-], so commas are not allowed.
# Default: _
# Example label value: ccx33_ccx23  (try ccx33 first, fall back to ccx23)
# TARGETS_SEPARATOR=_

# Polling interval for availability checks (seconds). Default: 60
POLL_INTERVAL_SECONDS=60

# Polling interval for action status (seconds). Default: 3
ACTION_POLL_INTERVAL_SECONDS=3

# Max time to wait for a single action (seconds). Default: 600
ACTION_TIMEOUT_SECONDS=600

# ntfy push notifications (Standard https://ntfy.sh oder self-hosted via NTFY_SERVER).
# NTFY_TOPIC=my-private-topic-abc123
# NTFY_SERVER=https://ntfy.sh

# Authentifizierung fuer einen privaten ntfy-Server (optional).
# Token wird bevorzugt; alternativ Basic Auth via NTFY_USER + NTFY_PASSWORD.
# NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxx
# NTFY_USER=
# NTFY_PASSWORD=

# Pushover (https://pushover.net) als alternativer oder zusaetzlicher Kanal.
# Beides muss gesetzt sein, damit Pushover aktiv ist.
# PUSHOVER_TOKEN=<application API token>
# PUSHOVER_USER=<user oder group key>
# Optional auf ein einzelnes Geraet beschraenken:
# PUSHOVER_DEVICE=

# Beim Start eine Test-Notification senden, um zu pruefen, dass Topic/Token stimmen.
# Default: true.
# NOTIFY_ON_START=true

# Wie lange (Sekunden) eine wiederkehrende identische Fehler-Meldung
# unterdrueckt wird, damit ntfy nicht zugespammt wird. Default: 1800 (30 min).
# ERROR_NOTIFY_COOLDOWN_SECONDS=1800

# If "true", only check availability and log; never actually rescale or strip labels
DRY_RUN=false
